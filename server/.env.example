# PayNivo server environment
# Copy this file to server/.env and replace placeholder values.
# Never commit server/.env or real passwords, API keys, SMTP credentials, or encryption keys.

# -----------------------------------------------------------------------------
# Application (required)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5002
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5002
PAYMENT_BASE_URL=http://localhost:5173
COMPANY_NAME=PayNivo
APP_TIMEZONE=Asia/Singapore
TZ=Asia/Singapore

# -----------------------------------------------------------------------------
# MySQL (required)
# Azure MySQL normally requires DB_SSL=true. Use false only for a trusted local DB.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=paynivo_user
DB_PASSWORD=replace-with-database-password
DB_NAME=paynivo
DB_SSL=false
DB_TIMEZONE=+08:00
DB_CONNECT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Authentication and security (required)
# Use separate strong random values. Do not reuse passwords as secrets.
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=1d
OTP_HASH_SECRET=replace-with-a-different-strong-random-secret
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

# Required for multi-tenant provisioning/encryption.
# Must be exactly 32 random bytes encoded as Base64.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep the same key after data has been encrypted or tenant data cannot be decrypted.
TENANT_MASTER_KEY=replace-with-base64-encoded-32-byte-key

# Used to encrypt stored WhatsApp configuration. Set a strong independent value.
WHATSAPP_ENCRYPTION_KEY=replace-with-a-different-strong-encryption-secret

# -----------------------------------------------------------------------------
# Email / SMTP
# Required for OTP, account setup, notifications, invoices, and payslips.
# For Gmail, SMTP_PASS should be a Google App Password, not the account password.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@example.com
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM="PayNivo <your-sender@example.com>"

# -----------------------------------------------------------------------------
# Platform Operator bootstrap
# Required only when running: npm run setup:platform-operator
# Password must contain at least 12 characters.
# Remove the password from .env after the operator has been created if preferred.
# -----------------------------------------------------------------------------
PLATFORM_OPERATOR_NAME=PayNivo Platform Operator
PLATFORM_OPERATOR_EMAIL=platform@example.com
PLATFORM_OPERATOR_PASSWORD=replace-with-a-strong-temporary-password

# Used only by the legacy company-owner migration.
DEFAULT_COMPANY_NAME=Demo SME

# -----------------------------------------------------------------------------
# Google sign-in (optional; all three values are needed when enabled)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5002/api/auth/google/callback

# -----------------------------------------------------------------------------
# Stripe invoice payments (optional)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# PayNow invoice QR payments (optional)
# Set either the company UEN or mobile proxy as appropriate.
# -----------------------------------------------------------------------------
PAYNOW_UEN=
PAYNOW_MOBILE=

# -----------------------------------------------------------------------------
# Modern Treasury payroll release (optional)
# With credentials omitted, supported development flows use simulation state.
# Never place production credentials in the example file.
# -----------------------------------------------------------------------------
MODERN_TREASURY_ORGANIZATION_ID=
MODERN_TREASURY_API_KEY=
MODERN_TREASURY_ORIGINATING_ACCOUNT_ID=
MODERN_TREASURY_PAYMENT_CURRENCY=USD
MODERN_TREASURY_PAYMENT_TYPE=ach
SIMULATED_TREASURY_BALANCE_SGD=500000

# -----------------------------------------------------------------------------
# Twilio WhatsApp (optional)
# Leave SID/token empty to keep real sending disabled.
# The callback must be a public HTTPS URL when enabled.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_STATUS_CALLBACK_URL=

# -----------------------------------------------------------------------------
# Background jobs
# Set the global switch to false to disable application schedulers locally.
# -----------------------------------------------------------------------------
SCHEDULERS_ENABLED=true
PAYROLL_RELEASE_SCHEDULER_ENABLED=true
PAYROLL_RELEASE_SCHEDULER_INTERVAL_MS=60000
INVOICE_SCHEDULER_ENABLED=true
INVOICE_SCHEDULER_INTERVAL_MS=60000
INVOICE_SCHEDULER_BATCH_SIZE=25
SUBSCRIPTION_SCHEDULER_ENABLED=true
SUBSCRIPTION_SCHEDULER_INTERVAL_MS=86400000
SUBSCRIPTION_SCHEDULER_BATCH_SIZE=50

# -----------------------------------------------------------------------------
# PDF generation (optional override)
# Leave empty to let PayNivo locate Chrome/Edge automatically.
# Example Windows path: C:\Program Files\Google\Chrome\Application\chrome.exe
# -----------------------------------------------------------------------------
PUPPETEER_EXECUTABLE_PATH=
