# =============================================================================
# PAYNIVO APPLICATION — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real credentials to version control.
# =============================================================================

NODE_ENV=development
PORT=5002
HOST=0.0.0.0

# Frontend URL (for CORS and redirect URLs)
CLIENT_URL=http://localhost:5173
# Backend base URL (for PDF links, webhook callbacks)
APP_BASE_URL=http://localhost:5002
# Used for payment links in emails/WhatsApp
PAYMENT_BASE_URL=http://localhost:5173

COMPANY_NAME=PayNivo
APP_TIMEZONE=Asia/Singapore
TZ=Asia/Singapore


# =============================================================================
# MYSQL DATABASE
# =============================================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

DB_SSL=false
DB_TIMEZONE=+08:00
DB_CONNECT_TIMEOUT_MS=10000


# =============================================================================
# AUTHENTICATION AND SECURITY
# =============================================================================

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
OTP_HASH_SECRET=

TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

# Tenant encryption key (base64, 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: Once tenant data is encrypted, do not change or lose this key.
TENANT_MASTER_KEY=

# WhatsApp config encryption key (hex, 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_ENCRYPTION_KEY=


# =============================================================================
# DEVELOPMENT INTEGRATION TESTING
# =============================================================================

# Set to the customer_id of your Test Customer (optional — falls back to name match)
TEST_CUSTOMER_ID=

# Set to true to enable test email/WhatsApp endpoints in production (not recommended)
ENABLE_INTEGRATION_TEST_ENDPOINTS=true


# =============================================================================
# STRIPE PAYMENTS
# =============================================================================
# Get test keys from: https://dashboard.stripe.com/test/apikeys
# Webhook secret from: https://dashboard.stripe.com/test/webhooks
# or via Stripe CLI: stripe listen --forward-to localhost:5002/api/payments/stripe/webhook

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: override redirect URLs (defaults use CLIENT_URL + /payment/success and /payment/cancelled)
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=


# =============================================================================
# SMTP EMAIL (Nodemailer)
# =============================================================================
# For Gmail: Host=smtp.gmail.com, Port=587, use App Password (not regular password)
# For Outlook: Host=smtp.office365.com, Port=587

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Compatibility alias (some modules read this)
EMAIL_FROM=


# =============================================================================
# TWILIO WHATSAPP
# =============================================================================
# WhatsApp credentials are stored encrypted in the database (whatsapp_config table).
# These env vars are used by the add-test-customer script and as initial fallback.
# Configure WhatsApp via Admin → Settings → WhatsApp Integration in the UI.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=http://localhost:5002/api/whatsapp/webhook/status


# =============================================================================
# PAYNOW
# =============================================================================

PAYNOW_UEN=


# =============================================================================
# MODERN TREASURY PAYROLL PAYMENTS
# =============================================================================

MODERN_TREASURY_ORGANIZATION_ID=
MODERN_TREASURY_API_KEY=
MODERN_TREASURY_ORIGINATING_ACCOUNT_ID=
MODERN_TREASURY_PAYMENT_TYPE=ach
MODERN_TREASURY_PAYMENT_CURRENCY=USD
SIMULATED_TREASURY_BALANCE_SGD=5000000


# =============================================================================
# PLATFORM OPERATOR SETUP
# =============================================================================

PLATFORM_OPERATOR_NAME=
PLATFORM_OPERATOR_EMAIL=
PLATFORM_OPERATOR_PASSWORD=
DEFAULT_COMPANY_NAME=


# =============================================================================
# BACKGROUND SCHEDULERS
# =============================================================================

SCHEDULERS_ENABLED=true
PAYROLL_RELEASE_SCHEDULER_ENABLED=true
PAYROLL_RELEASE_SCHEDULER_INTERVAL_MS=60000
INVOICE_SCHEDULER_ENABLED=true
INVOICE_SCHEDULER_INTERVAL_MS=60000
INVOICE_SCHEDULER_BATCH_SIZE=25
SUBSCRIPTION_SCHEDULER_ENABLED=true
SUBSCRIPTION_SCHEDULER_INTERVAL_MS=86400000
SUBSCRIPTION_SCHEDULER_BATCH_SIZE=50


# =============================================================================
# PDF GENERATION
# =============================================================================
# Leave blank to auto-detect Chrome/Edge. Set path if auto-detection fails.
# Example: C:\Program Files\Google\Chrome\Application\chrome.exe

PUPPETEER_EXECUTABLE_PATH=
