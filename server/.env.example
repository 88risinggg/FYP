PORT=5002
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# Set to false when you want to run the API without background invoice/reminder jobs.
SCHEDULERS_ENABLED=true

# Optional: only needed when switching from simulation mode to Modern Treasury sandbox API mode.
# Keep real values in server/.env, never in committed files.
MODERN_TREASURY_ORGANIZATION_ID=
MODERN_TREASURY_API_KEY=
MODERN_TREASURY_ORIGINATING_ACCOUNT_ID=
MODERN_TREASURY_PAYMENT_CURRENCY=USD
MODERN_TREASURY_PAYMENT_TYPE=ach
SIMULATED_TREASURY_BALANCE_SGD=500000

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
OTP_HASH_SECRET=replace-with-a-different-long-random-secret
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

# SMTP is required for login OTP and approved-account setup emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
