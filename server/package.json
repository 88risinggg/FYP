{
  "name": "fyp-server",
  "version": "1.0.0",
  "description": "Node.js backend for FYP system",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:invoice-upload-history": "node scripts/create-invoice-upload-history-tables.js",
    "db:invoice-settings": "node scripts/create-canonical-invoice-settings.js",
    "db:invoice-gst-rates": "node scripts/run-invoice-gst-rates-migration.js",
    "db:support-tables": "node scripts/run-support-migration.js",
    "db:payroll-user-workflow": "node scripts/run-payroll-user-workflow-migration.js",
    "db:payroll-rule-metadata": "node scripts/run-payroll-rule-metadata-migration.js",
    "db:claim-payroll-inclusion": "node scripts/run-claim-payroll-inclusion-migration.js",
    "db:finance-payroll-schedule": "node scripts/run-finance-payroll-schedule-migration.js",
    "db:finance-reminders": "node scripts/migrate-finance-reminders.js",
    "db:whatsapp-notifications": "node scripts/migrate-whatsapp-notifications.js",
    "db:whatsapp-templates": "node scripts/migrate-whatsapp-templates.js",
    "seed:demo": "node scripts/generate-demo-data.js",
    "seed:templates": "node scripts/generate-sample-templates.js",
    "db:account-lockout": "node scripts/run-account-lockout-migration.js",
    "db:enable-email-2fa": "node scripts/enable-email-2fa-default.js",
    "db:multi-tenant": "node scripts/run-multi-tenant-migration.js",
    "db:encrypt-tenants": "node scripts/backfill-tenant-encryption.js",
    "verify:multi-tenant": "node scripts/reconcile-multi-tenant-migration.js",
    "setup:platform-operator": "node scripts/create-platform-operator.js",
    "db:migrate-workflow": "node scripts/migrate-complete-workflow.js",
    "db:migrate-auth": "node scripts/migrate-auth-otp-registration.js",
    "seed:fraud-test": "node scripts/seed-fraud-test-dataset.js",
    "verify:fraud-test": "node scripts/verify-fraud-test-dataset.js",
    "verify:invoice-pdf": "node scripts/verify-approved-invoice-pdf.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --forceExit --detectOpenHandles --coverage"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "fyp": "file:..",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.12.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.9",
    "puppeteer-core": "^25.2.1",
    "qrcode": "1.5.4",
    "stripe": "^22.3.0",
    "twilio": "^5.4.0"
  },
  "devDependencies": {
    "fast-check": "^4.8.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
