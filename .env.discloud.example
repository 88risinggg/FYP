# Copy these names into Discloud's Environment Variables panel.
# Do not upload real secrets in this file.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
CLIENT_URL=https://paynivo-fyp.discloud.app
APP_BASE_URL=https://paynivo-fyp.discloud.app
PAYMENT_BASE_URL=https://paynivo-fyp.discloud.app
APP_TIMEZONE=Asia/Singapore
TZ=Asia/Singapore

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=paynivo
DB_SSL=true
DB_TIMEZONE=+08:00
DB_CONNECT_TIMEOUT_MS=10000

JWT_SECRET=
JWT_EXPIRES_IN=1d
OTP_HASH_SECRET=
TENANT_MASTER_KEY=
WHATSAPP_ENCRYPTION_KEY=
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

MODERN_TREASURY_ORGANIZATION_ID=
MODERN_TREASURY_API_KEY=
MODERN_TREASURY_ORIGINATING_ACCOUNT_ID=
MODERN_TREASURY_PAYMENT_CURRENCY=USD
MODERN_TREASURY_PAYMENT_TYPE=ach

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK_URL=

SCHEDULERS_ENABLED=true
PAYROLL_RELEASE_SCHEDULER_ENABLED=true
INVOICE_SCHEDULER_ENABLED=true
SUBSCRIPTION_SCHEDULER_ENABLED=true

# The selenium APT bundle installs Chromium on Discloud.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
